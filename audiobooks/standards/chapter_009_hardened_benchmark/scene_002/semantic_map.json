    },
    {
      "beat_id": "scene_002_b039",
      "paragraph_idx": 11,
      "source_sentence": "You  had  to  flee  from  Gulet  as  fast  as  your  horse could  carry  you  because  the  girl  you'd  knocked  up  under  the  musicians'",
