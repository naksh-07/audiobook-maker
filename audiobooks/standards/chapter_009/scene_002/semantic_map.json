{
  "scene_id": "scene_002",
  "total_beats": 48,
  "source_hash": "5b5753570ca14380",
  "propositions": [
    {
      "beat_id": "scene_002_b001",
      "paragraph_idx": 0,
      "source_sentence": "Because  it  was  us,  human  beings,  who  were  the  intruders  here.",
      "actors": [
        "Who"
      ],
      "action": "",
      "recipients": [],
      "has_negation": false,
      "negation_keywords": [],
      "key_entities": [
        "Who"
      ],
      "key_objects": [],
      "is_dialogue": false,
      "speaker": null
    },
    {
      "beat_id": "scene_002_b002",
      "paragraph_idx": 0,
      "source_sentence": "This  land was ruled by dragons, manticores, griffins and amphisboenas, vampires and werewolves, striga, kikimoras, chimera and flying drakes.",
      "actors": [
        "And"
      ],
      "action": "",
      "recipients": [
        "This"
      ],
      "has_negation": false,
      "negation_keywords": [],
      "key_entities": [
        "And",
        "This"
      ],
      "key_objects": [],
      "is_dialogue": false,
      "speaker": null
    },
    {
      "beat_id": "scene_002_b003",
      "paragraph_idx": 0,
      "source_sentence": "And this land had to be taken from them bit by bit, every valley, every mountain pass, every forest and every meadow.",
      "actors": [
        "And"
      ],
      "action": "",
      "recipients": [
        "This",
        "To"
      ],
      "has_negation": false,
      "negation_keywords": [],
      "key_entities": [
        "And",
        "This",
        "To"
      ],
      "key_objects": [],
      "is_dialogue": false,
      "speaker": null
    },
    {
      "beat_id": "scene_002_b004",
      "paragraph_idx": 0,
      "source_sentence": "And we didn't manage that without the invaluable help of witchers.",
      "actors": [
        "That"
      ],
      "action": "",
      "recipients": [
        "And"
      ],
      "has_negation": true,
      "negation_keywords": [
        "didn't",
        "without"
      ],
      "key_entities": [
        "That",
        "And"
      ],
      "key_objects": [],
      "is_dialogue": false,
      "speaker": null
    },
    {
      "beat_id": "scene_002_b005",
      "paragraph_idx": 0,
      "source_sentence": "But those times have gone, Geralt, irrevocably gone.",
      "actors": [
        "Geralt"
      ],
      "action": "",
      "recipients": [
        "But"
      ],
      "has_negation": false,
      "negation_keywords": [],
      "key_entities": [
        "Geralt",
        "But"
      ],
      "key_objects": [],
      "is_dialogue": false,
      "speaker": null
    },
    {
      "beat_id": "scene_002_b006",
      "paragraph_idx": 0,
      "source_sentence": "The baron won't allow a fork-tail to be killed because it's the last draconid for a thousand miles and no longer gives rise to fear but rather to compassion and nostalgia for times passed.",
      "actors": [
        "No"
      ],
      "action": "",
      "recipients": [
        "And",
        "But",
        "To"
      ],
      "has_negation": true,
      "negation_keywords": [
        "won't",
        "no"
      ],
      "key_entities": [
        "No",
        "And",
        "But",
        "To"
      ],
      "key_objects": [],
      "is_dialogue": true,
      "speaker": "No"
    },
    {
      "beat_id": "scene_002_b007",
      "paragraph_idx": 0,
      "source_sentence": "The troll under the bridge gets on with people.",
      "actors": [],
      "action": "",
      "recipients": [],
      "has_negation": false,
      "negation_keywords": [],
      "key_entities": [],
      "key_objects": [],
      "is_dialogue": false,
      "speaker": null
    },
    {
      "beat_id": "scene_002_b008",
      "paragraph_idx": 1,
      "source_sentence": "He's  not  a  monster  used  to  frighten  children.",
      "actors": [
        "Not"
      ],
      "action": "",
      "recipients": [
        "To"
      ],
      "has_negation": true,
      "negation_keywords": [
        "not"
      ],
      "key_entities": [
        "Not",
        "To"
      ],
      "key_objects": [],
      "is_dialogue": false,
      "speaker": null
    },
    {
      "beat_id": "scene_002_b009",
      "paragraph_idx": 1,
      "source_sentence": "He's  a  relic  and  a  local attraction — and  a  useful  one  at  that.",
      "actors": [
        "That"
      ],
      "action": "",
      "recipients": [
        "And"
      ],
      "has_negation": false,
      "negation_keywords": [],
      "key_entities": [
        "That",
        "And"
      ],
      "key_objects": [],
      "is_dialogue": false,
      "speaker": null
    },
    {
      "beat_id": "scene_002_b010",
      "paragraph_idx": 1,
      "source_sentence": "And  chimera,  manticores  and amphisboenas?",
      "actors": [
        "And"
      ],
      "action": "",
      "recipients": [],
      "has_negation": false,
      "negation_keywords": [],
      "key_entities": [
        "And"
      ],
      "key_objects": [],
      "is_dialogue": false,
      "speaker": null
    },
    {
      "beat_id": "scene_002_b011",
      "paragraph_idx": 1,
      "source_sentence": "They dwell in virgin forests and inaccessible mountains — \"",
      "actors": [
        "And"
      ],
      "action": "",
      "recipients": [],
      "has_negation": false,
      "negation_keywords": [],
      "key_entities": [
        "And"
      ],
      "key_objects": [],
      "is_dialogue": false,
      "speaker": null
    },
    {
      "beat_id": "scene_002_b012",
      "paragraph_idx": 2,
      "source_sentence": "\"So I was right.",
      "actors": [
        "So"
      ],
      "action": "",
      "recipients": [],
      "has_negation": false,
      "negation_keywords": [],
      "key_entities": [
        "So"
      ],
      "key_objects": [],
      "is_dialogue": false,
      "speaker": null
    },
    {
      "beat_id": "scene_002_b013",
      "paragraph_idx": 2,
      "source_sentence": "Something is coming to an end.",
      "actors": [
        "Something"
      ],
      "action": "",
      "recipients": [
        "To"
      ],
      "has_negation": false,
      "negation_keywords": [],
      "key_entities": [
        "Something",
        "To"
      ],
      "key_objects": [],
      "is_dialogue": false,
      "speaker": null
    },
    {
      "beat_id": "scene_002_b014",
      "paragraph_idx": 2,
      "source_sentence": "Whether you like it or not, something's coming to an end.\"",
      "actors": [
        "You"
      ],
      "action": "",
      "recipients": [
        "Not",
        "Something",
        "To"
      ],
      "has_negation": true,
      "negation_keywords": [
        "not"
      ],
      "key_entities": [
        "You",
        "Not",
        "Something",
        "To"
      ],
      "key_objects": [],
      "is_dialogue": true,
      "speaker": "You"
    },
    {
      "beat_id": "scene_002_b015",
      "paragraph_idx": 3,
      "source_sentence": "\"I don't like you mouthing banal platitudes.",
      "actors": [
        "You"
      ],
      "action": "",
      "recipients": [],
      "has_negation": true,
      "negation_keywords": [
        "don't"
      ],
      "key_entities": [
        "You"
      ],
      "key_objects": [],
      "is_dialogue": true,
      "speaker": "You"
    },
    {
      "beat_id": "scene_002_b016",
      "paragraph_idx": 3,
      "source_sentence": "I don't like your expression when you do it.",
      "actors": [
        "Do"
      ],
      "action": "",
      "recipients": [
        "You",
        "Your"
      ],
      "has_negation": true,
      "negation_keywords": [
        "don't"
      ],
      "key_entities": [
        "Do",
        "You",
        "Your"
      ],
      "key_objects": [],
      "is_dialogue": false,
      "speaker": null
    },
    {
      "beat_id": "scene_002_b017",
      "paragraph_idx": 3,
      "source_sentence": "What's happening to you?",
      "actors": [
        "You"
      ],
      "action": "",
      "recipients": [
        "To"
      ],
      "has_negation": false,
      "negation_keywords": [],
      "key_entities": [
        "You",
        "To"
      ],
      "key_objects": [],
      "is_dialogue": false,
      "speaker": null
    },
    {
      "beat_id": "scene_002_b018",
      "paragraph_idx": 3,
      "source_sentence": "I don't recognize you, Geralt.",
      "actors": [
        "Geralt"
      ],
      "action": "",
      "recipients": [
        "You"
      ],
      "has_negation": true,
      "negation_keywords": [
        "don't"
      ],
      "key_entities": [
        "Geralt",
        "You"
      ],
      "key_objects": [],
      "is_dialogue": false,
      "speaker": null
    },
    {
      "beat_id": "scene_002_b019",
      "paragraph_idx": 3,
      "source_sentence": "Ah, plague on it, let's go south as soon as possible, to those wild countries.",
      "actors": [
        "As"
      ],
      "action": "",
      "recipients": [
        "Ah",
        "To"
      ],
      "has_negation": false,
      "negation_keywords": [],
      "key_entities": [
        "As",
        "Ah",
        "To"
      ],
      "key_objects": [],
      "is_dialogue": false,
      "speaker": null
    },
    {
      "beat_id": "scene_002_b020",
      "paragraph_idx": 3,
      "source_sentence": "As soon  as  you've  cut  down  a  couple  of  monsters,  your  blues  will  disappear.",
      "actors": [
        "You"
      ],
      "action": "",
      "recipients": [
        "As",
        "Your"
      ],
      "has_negation": false,
      "negation_keywords": [],
      "key_entities": [
        "You",
        "As",
        "Your"
      ],
      "key_objects": [],
      "is_dialogue": false,
      "speaker": null
    },
    {
      "beat_id": "scene_002_b021",
      "paragraph_idx": 4,
      "source_sentence": "And there's supposed to be a fair number of monsters down there.",
      "actors": [
        "And"
      ],
      "action": "",
      "recipients": [
        "To"
      ],
      "has_negation": false,
      "negation_keywords": [],
      "key_entities": [
        "And",
        "To"
      ],
      "key_objects": [],
      "is_dialogue": false,
      "speaker": null
    },
    {
      "beat_id": "scene_002_b022",
      "paragraph_idx": 4,
      "source_sentence": "They say",
      "actors": [],
      "action": "",
      "recipients": [],
      "has_negation": false,
      "negation_keywords": [],
      "key_entities": [],
      "key_objects": [],
      "is_dialogue": false,
      "speaker": null
    },
    {
      "beat_id": "scene_002_b023",
      "paragraph_idx": 5,
      "source_sentence": "that when an old woman's tired of life, she goes alone and weaponless into the  woods  to  collect  brushwood.",
      "actors": [
        "That"
      ],
      "action": "",
      "recipients": [
        "And",
        "To"
      ],
      "has_negation": false,
      "negation_keywords": [],
      "key_entities": [
        "That",
        "And",
        "To"
      ],
      "key_objects": [],
      "is_dialogue": false,
      "speaker": null
    },
    {
      "beat_id": "scene_002_b024",
      "paragraph_idx": 5,
      "source_sentence": "The  consequences  are  guaranteed.",
      "actors": [
        "Are"
      ],
      "action": "",
      "recipients": [],
      "has_negation": false,
      "negation_keywords": [],
      "key_entities": [
        "Are"
      ],
      "key_objects": [],
      "is_dialogue": false,
      "speaker": null
    },
    {
      "beat_id": "scene_002_b025",
      "paragraph_idx": 5,
      "source_sentence": "You should go and settle there for good.\"",
      "actors": [
        "You"
      ],
      "action": "",
      "recipients": [
        "And"
      ],
      "has_negation": false,
      "negation_keywords": [],
      "key_entities": [
        "You",
        "And"
      ],
      "key_objects": [],
      "is_dialogue": false,
      "speaker": null
    },
    {
      "beat_id": "scene_002_b026",
      "paragraph_idx": 6,
      "source_sentence": "\"Maybe I should.",
      "actors": [],
      "action": "",
      "recipients": [],
      "has_negation": false,
      "negation_keywords": [],
      "key_entities": [],
      "key_objects": [],
      "is_dialogue": false,
      "speaker": null
    },
    {
      "beat_id": "scene_002_b027",
      "paragraph_idx": 6,
      "source_sentence": "But I won't.\"",
      "actors": [
        "But"
      ],
      "action": "",
      "recipients": [],
      "has_negation": true,
      "negation_keywords": [
        "won't"
      ],
      "key_entities": [
        "But"
      ],
      "key_objects": [],
      "is_dialogue": true,
      "speaker": "But"
    },
    {
      "beat_id": "scene_002_b028",
      "paragraph_idx": 7,
      "source_sentence": "\"Why?",
      "actors": [],
      "action": "",
      "recipients": [],
      "has_negation": false,
      "negation_keywords": [],
      "key_entities": [],
      "key_objects": [],
      "is_dialogue": false,
      "speaker": null
    },
    {
      "beat_id": "scene_002_b029",
      "paragraph_idx": 7,
      "source_sentence": "It's easier for a witcher to make money there.\"",
      "actors": [
        "To"
      ],
      "action": "",
      "recipients": [],
      "has_negation": false,
      "negation_keywords": [],
      "key_entities": [
        "To"
      ],
      "key_objects": [],
      "is_dialogue": true,
      "speaker": "To"
    },
    {
      "beat_id": "scene_002_b030",
      "paragraph_idx": 8,
      "source_sentence": "\"Easier  to  make  money.\"  Geralt  took  a  sip  from  the  demijohn.",
      "actors": [
        "Geralt"
      ],
      "action": "",
      "recipients": [
        "To"
      ],
      "has_negation": false,
      "negation_keywords": [],
      "key_entities": [
        "Geralt",
        "To"
      ],
      "key_objects": [],
      "is_dialogue": true,
      "speaker": "Geralt"
    },
    {
      "beat_id": "scene_002_b031",
      "paragraph_idx": 8,
      "source_sentence": "\"But harder to spend it.",
      "actors": [
        "But"
      ],
      "action": "",
      "recipients": [
        "To"
      ],
      "has_negation": false,
      "negation_keywords": [],
      "key_entities": [
        "But",
        "To"
      ],
      "key_objects": [],
      "is_dialogue": false,
      "speaker": null
    },
    {
      "beat_id": "scene_002_b032",
      "paragraph_idx": 8,
      "source_sentence": "And on top of that, they eat pearl barley and millet, the beer tastes like piss, the girls don't wash and the mosquitoes bite.\"",
      "actors": [
        "That"
      ],
      "action": "",
      "recipients": [
        "And"
      ],
      "has_negation": true,
      "negation_keywords": [
        "don't"
      ],
      "key_entities": [
        "That",
        "And"
      ],
      "key_objects": [],
      "is_dialogue": true,
      "speaker": "That"
    },
    {
      "beat_id": "scene_002_b033",
      "paragraph_idx": 9,
      "source_sentence": "Dandilion chuckled loudly and rested his head against the bookshelf, on the leather-bound volumes.",
      "actors": [
        "Dandilion"
      ],
      "action": "",
      "recipients": [
        "And"
      ],
      "has_negation": false,
      "negation_keywords": [],
      "key_entities": [
        "Dandilion",
        "And"
      ],
      "key_objects": [],
      "is_dialogue": false,
      "speaker": null
    },
    {
      "beat_id": "scene_002_b034",
      "paragraph_idx": 10,
      "source_sentence": "\"Millet and mosquitoes!",
      "actors": [
        "And"
      ],
      "action": "",
      "recipients": [],
      "has_negation": false,
      "negation_keywords": [],
      "key_entities": [
        "And"
      ],
      "key_objects": [],
      "is_dialogue": false,
      "speaker": null
    },
    {
      "beat_id": "scene_002_b035",
      "paragraph_idx": 10,
      "source_sentence": "That reminds me of our first expedition together to the edge of the world,\" he said.",
      "actors": [
        "That"
      ],
      "action": "",
      "recipients": [
        "To"
      ],
      "has_negation": false,
      "negation_keywords": [],
      "key_entities": [
        "That",
        "To"
      ],
      "key_objects": [],
      "is_dialogue": false,
      "speaker": null
    },
    {
      "beat_id": "scene_002_b036",
      "paragraph_idx": 10,
      "source_sentence": "\"Do you remember?",
      "actors": [
        "Do"
      ],
      "action": "",
      "recipients": [
        "You"
      ],
      "has_negation": false,
      "negation_keywords": [],
      "key_entities": [
        "Do",
        "You"
      ],
      "key_objects": [],
      "is_dialogue": false,
      "speaker": null
    },
    {
      "beat_id": "scene_002_b037",
      "paragraph_idx": 10,
      "source_sentence": "We met at the fête in Gulet and you persuaded me — \"",
      "actors": [
        "You"
      ],
      "action": "",
      "recipients": [
        "And",
        "Gulet"
      ],
      "has_negation": false,
      "negation_keywords": [],
      "key_entities": [
        "You",
        "And",
        "Gulet"
      ],
      "key_objects": [],
      "is_dialogue": false,
      "speaker": null
    },
    {
      "beat_id": "scene_002_b038",
      "paragraph_idx": 11,
      "source_sentence": "\"You  persuaded  me!",
      "actors": [
        "You"
      ],
      "action": "",
      "recipients": [],
      "has_negation": false,
      "negation_keywords": [],
      "key_entities": [
        "You"
      ],
      "key_objects": [],
      "is_dialogue": false,
      "speaker": null
    },
    {
      "beat_id": "scene_002_b039",
      "paragraph_idx": 11,
      "source_sentence": "You  had  to  flee  from  Gulet  as  fast  as  your  horse could  carry  you  because  the  girl  you'd  knocked  up  under  the  musicians'",
      "actors": [
        "You"
      ],
      "action": "",
      "recipients": [
        "As",
        "Your",
        "To",
        "Gulet"
      ],
      "has_negation": false,
      "negation_keywords": [],
      "key_entities": [
        "You",
        "As",
        "Your",
        "To",
        "Gulet"
      ],
      "key_objects": [],
      "is_dialogue": true,
      "speaker": "You"
    },
    {
      "beat_id": "scene_002_b040",
      "paragraph_idx": 12,
      "source_sentence": "podium had four sturdy brothers.",
      "actors": [],
      "action": "",
      "recipients": [],
      "has_negation": false,
      "negation_keywords": [],
      "key_entities": [],
      "key_objects": [],
      "is_dialogue": false,
      "speaker": null
    },
    {
      "beat_id": "scene_002_b041",
      "paragraph_idx": 12,
      "source_sentence": "They were looking for you all over town, threatening to geld you and cover you in pitch and sawdust.",
      "actors": [
        "You"
      ],
      "action": "",
      "recipients": [
        "And",
        "To"
      ],
      "has_negation": false,
      "negation_keywords": [],
      "key_entities": [
        "You",
        "And",
        "To"
      ],
      "key_objects": [],
      "is_dialogue": false,
      "speaker": null
    },
    {
      "beat_id": "scene_002_b042",
      "paragraph_idx": 12,
      "source_sentence": "That's why you hung on to me then.\"",
      "actors": [
        "You"
      ],
      "action": "",
      "recipients": [
        "That",
        "To"
      ],
      "has_negation": false,
      "negation_keywords": [],
      "key_entities": [
        "You",
        "That",
        "To"
      ],
      "key_objects": [],
      "is_dialogue": true,
      "speaker": "You"
    },
    {
      "beat_id": "scene_002_b043",
      "paragraph_idx": 13,
      "source_sentence": "\"And  you  almost  jumped  out  of  your  pants  with  joy  to  have  a companion.",
      "actors": [
        "You"
      ],
      "action": "",
      "recipients": [
        "Your",
        "And",
        "To"
      ],
      "has_negation": false,
      "negation_keywords": [],
      "key_entities": [
        "You",
        "Your",
        "And",
        "To"
      ],
      "key_objects": [],
      "is_dialogue": false,
      "speaker": null
    },
    {
      "beat_id": "scene_002_b044",
      "paragraph_idx": 13,
      "source_sentence": "Until  then,  you  only  had  your  horse  for  company.",
      "actors": [
        "You"
      ],
      "action": "",
      "recipients": [
        "Your"
      ],
      "has_negation": false,
      "negation_keywords": [],
      "key_entities": [
        "You",
        "Your"
      ],
      "key_objects": [],
      "is_dialogue": false,
      "speaker": null
    },
    {
      "beat_id": "scene_002_b045",
      "paragraph_idx": 13,
      "source_sentence": "But  you're right; it was as you say.",
      "actors": [
        "You"
      ],
      "action": "",
      "recipients": [
        "As",
        "But"
      ],
      "has_negation": false,
      "negation_keywords": [],
      "key_entities": [
        "You",
        "As",
        "But"
      ],
      "key_objects": [],
      "is_dialogue": false,
      "speaker": null
    },
    {
      "beat_id": "scene_002_b046",
      "paragraph_idx": 13,
      "source_sentence": "I did have to disappear for a while, and the Valley of Flowers seemed just right for my purpose.",
      "actors": [
        "And"
      ],
      "action": "",
      "recipients": [
        "To"
      ],
      "has_negation": false,
