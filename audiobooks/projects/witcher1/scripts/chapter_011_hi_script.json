  },
  {
    "index": 28,
    "type": "dialogue",
    "speaker": "Nenneke",
    "text": "हिफ़ाज़त के लिए?",
    "emotion": "neutral",
    "pause_after_ms": 400,
    "acting": {
      "delivery_style": "neutral",
      "pacing": 1.0
    },
    "spatial": {
