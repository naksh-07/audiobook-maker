    "intensity_level": "low",
    "pre_roll_breath_ms": 0
  },
  {
    "index": 29,
    "type": "dialogue",
    "speaker": "Geralt",
    "text": "नहीं। नेफ्राइट मंदिर के लिए रख लीजिए, मेलिटेले देवी को मेरी भेंट समझकर। और बाकी पत्थर... उसके लिए हैं। येनेफ़र के लिए। उसे दे दीजिएगा जब वह फिर से आपके पास आए, जो यकीनन जल्दी ही होगा।",
    "emotion": "neutral",
    "pause_after_ms": 500,
    "acting": {
      "delivery_style": "neutral",
      "pacing": 0.9
    },
    "spatial": {
      "pan": -0.2,
      "proximity": "normal_room"
