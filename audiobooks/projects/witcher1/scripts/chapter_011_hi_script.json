    "pre_roll_breath_ms": 0
  },
  {
    "index": 27,
    "type": "dialogue",
    "speaker": "Geralt",
    "text": "मैं चाहता हूँ आप इन्हें रख लें।",
    "emotion": "neutral",
    "pause_after_ms": 400,
    "acting": {
