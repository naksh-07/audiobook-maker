  {
    "index": 7,
    "type": "narration",
    "speaker": "Narrator",
    "text": "टेल्स ने ज़ोर देते हुए बात काटी। उस युवा शूरवीर ने अपनी नफरत भरी नीली आँखें पुजारिन पर टिका दीं।",
    "emotion": "tense",
    "pause_after_ms": 350,
    "acting": {
      "delivery_style": "observant",
      "pacing": 1.0
    },
    "spatial": {
