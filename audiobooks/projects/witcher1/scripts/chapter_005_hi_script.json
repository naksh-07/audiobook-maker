    "sfx_cues": [],
    "music": {
      "mood": "tense_investigation",
      "ducking_db": -16.0
    }
  },
  {
    "index": 27,
    "type": "dialogue",
    "speaker": "Nenneke",
    "text": "मैंने ही तुम्हें पैदा होते वक्त अपने हाथों में लिया था, ओ बदतमीज़ लड़के, और मुझे तुम्हारी माँ पर तरस आता है। लेकिन अपनी किस्मत को मत आज़माओ। और मुझे तुम्हें तमीज़ सिखाने पर मजबूर मत करो!",
    "emotion": "scornful_furious",
    "pause_after_ms": 500,
    "acting": {
      "delivery_style": "scathing_motherly_fury",
      "pacing": 0.95
