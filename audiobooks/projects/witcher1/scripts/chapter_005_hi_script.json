      "ducking_db": -16.0
    }
  },
  {
    "index": 17,
    "type": "dialogue",
    "speaker": "Nenneke",
    "text": "रिविया का विचर, गेराल्ट, मेरा मेहमान है। उसका यहाँ रुकना मेरे लिए खुशी की बात है। इसलिए, वो जब तक चाहे मेरे मंदिर में रुक सकता है।",
    "emotion": "resolute_firm",
    "pause_after_ms": 500,
    "acting": {
      "delivery_style": "unyielding",
      "pacing": 0.95
    },
    "spatial": {
