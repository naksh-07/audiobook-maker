    "music": {
      "mood": "tense_investigation",
      "ducking_db": -16.0
    }
  },
  {
    "index": 41,
    "type": "dialogue",
    "speaker": "Geralt",
    "text": "हालाँकि, आजकल उस पंथ का हिस्सा बनने के लिए परिषद की तिजोरी में बस हज़ार नोविग्राड क्राउन जमा करना ही काफी है, इसलिए ये पंथ अब सूदखोरों और दर्जियों के बेटों से भर गया है—पर फिर भी, थोड़ी बहुत तमीज़ तो बची ही होगी? या शायद मैं गलत हूँ?",
    "emotion": "mocking_insult",
    "pause_after_ms": 450,
    "acting": {
      "delivery_style": "sardonic_smirk",
      "pacing": 0.94
    },
    "spatial": {
      "pan": -0.15,
