      "ducking_db": -16.0
    }
  },
  {
    "index": 9,
    "type": "dialogue",
    "speaker": "Nenneke",
    "text": "चलो, इन छोटे-मोटे ओहदों और उपाधियों में वक्त बर्बाद नहीं करते। मेरे ज़माने में सिर्फ शाही खून वालों को राजकुमार कहा जाता था, पर आजकल तो जैसे इन उपाधियों की कोई कीमत ही नहीं रही।",
    "emotion": "condescending_amused",
    "pause_after_ms": 400,
    "acting": {
      "delivery_style": "scoffing",
      "pacing": 0.96
    },
    "spatial": {
      "pan": 0.0,
      "proximity": "normal_room"
    },
    "acoustic_env": "temple_stone_hall",
    "sfx_cues": [],
