  },
  {
    "index": 23,
    "type": "narration",
    "speaker": "Narrator",
    "text": "नेनेके ने अपनी कमर पर बँधी थैली से एक छोटी सी चीनी मिट्टी की शीशी निकाली।",
    "emotion": "neutral",
    "pause_after_ms": 400,
    "acting": {
