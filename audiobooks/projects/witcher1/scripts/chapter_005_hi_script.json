      "ducking_db": -16.0
    }
  },
  {
    "index": 4,
    "type": "narration",
    "speaker": "Narrator",
    "text": "नेनेके, जो ऊपर से सहज और मुस्कुराती दिख रही थीं, ने उसकी हैरानी ताड़ ली।",
    "emotion": "neutral",
    "pause_after_ms": 350,
    "acting": {
      "delivery_style": "warm",
      "pacing": 1.0
    },
    "spatial": {
