      "ducking_db": -16.0
    }
  },
  {
    "index": 12,
    "type": "narration",
    "speaker": "Narrator",
    "text": "विचर ने एक बार फिर पहले की तरह ही बेरुखी से सिर झुकाया।",
    "emotion": "neutral",
    "pause_after_ms": 350,
    "acting": {
      "delivery_style": "observant",
      "pacing": 1.0
    },
    "spatial": {
      "pan": 0.0,
