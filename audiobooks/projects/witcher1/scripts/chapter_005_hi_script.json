      "ducking_db": -16.0
    }
  },
  {
    "index": 13,
    "type": "dialogue",
    "speaker": "Nenneke",
    "text": "मुझे तो नहीं लगता। ये यहाँ तुम्हारा सम्मान करने नहीं आए हैं। बल्कि इसके उलट, ये माँग करने आए हैं कि तुम यहाँ से फौरन चले जाओ। सीधे शब्दों में कहें, तो ये तुम्हें यहाँ से खदेड़ने आए हैं। क्या तुम्हें ये सम्मान की बात लगती है? मुझे तो नहीं। मेरे लिए तो ये सरासर अपमान है।",
    "emotion": "scornful_protective",
    "pause_after_ms": 450,
    "acting": {
      "delivery_style": "blunt_authoritative",
      "pacing": 0.96
    },
    "spatial": {
      "pan": 0.0,
      "proximity": "normal_room"
    },
    "acoustic_env": "temple_stone_hall",
    "sfx_cues": [],
    "music": {
      "mood": "tense_investigation",
      "ducking_db": -16.0
    }
  },
  {
    "index": 14,
    "type": "dialogue",
    "speaker": "Geralt",
    "text": "इन नेक शूरवीरों ने बेकार ही ज़हमत उठाई। मेरा यहाँ बसने का कोई इरादा नहीं है। मैं वैसे भी जल्द ही अपनी मर्ज़ी से यहाँ से जा रहा हूँ, किसी दबाव की ज़रूरत नहीं है।",
    "emotion": "weary_shrug",
    "pause_after_ms": 400,
    "acting": {
      "delivery_style": "calm_dismissive",
      "pacing": 0.94
    },
    "spatial": {
      "pan": -0.15,
      "proximity": "normal_room"
    },
    "acoustic_env": "temple_stone_hall",
    "sfx_cues": [],
