  },
  {
    "index": 40,
    "type": "dialogue",
    "speaker": "Geralt",
    "text": "चुप हो जा, ओ छोकरे। अपनी इस बेकाबू ज़बान को लगाम दो। तुम एक ऐसी महिला से बात कर रहे हो जो सम्मान की हकदार हैं, खासकर सफेद गुलाब के एक शूरवीर की तरफ से।",
    "emotion": "cold_menace",
    "pause_after_ms": 400,
    "acting": {
      "delivery_style": "venomous_whisper",
      "pacing": 0.92
    },
    "spatial": {
      "pan": -0.15,
      "proximity": "normal_room"
    },
    "acoustic_env": "temple_stone_hall",
