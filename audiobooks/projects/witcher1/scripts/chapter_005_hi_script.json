  },
  {
    "index": 8,
    "type": "dialogue",
    "speaker": "Tailles",
    "text": "राजकुमार हियरवर्ड।",
    "emotion": "arrogant_proud",
    "pause_after_ms": 400,
    "acting": {
      "delivery_style": "haughty_emphasis",
      "pacing": 1.02
