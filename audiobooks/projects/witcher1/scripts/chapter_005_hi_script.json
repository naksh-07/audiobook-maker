    },
    "acoustic_env": "temple_stone_hall",
    "sfx_cues": [
      "porcelain_jar"
    ],
    "music": {
      "mood": "tense_investigation",
      "ducking_db": -16.0
    }
  },
  {
    "index": 24,
    "type": "dialogue",
    "speaker": "Nenneke",
    "text": "टेल्स, मुझे सच में नहीं पता, कि अगर मैं इस शीशी को तुम्हारे पैरों के पास फोड़ दूँ, तो क्या होगा। शायद तुम्हारे फेफड़े फट जाएं। शायद तुम्हारे शरीर पर बाल उग आएं। या शायद दोनों ही हो जाएं, कौन जाने? बस दयालु मेलीतेले ही जानती हैं।",
    "emotion": "deadpan_menace",
    "pause_after_ms": 500,
    "acting": {
      "delivery_style": "whispered_threat",
      "pacing": 0.92
    },
