  },
  {
    "index": 15,
    "type": "dialogue",
    "speaker": "Tailles",
    "text": "अभी के अभी! एक पल की भी देरी नहीं। राजकुमार का हुक्म है—",
    "emotion": "aggressive_snarl",
    "pause_after_ms": 300,
    "acting": {
      "delivery_style": "barking_command",
      "pacing": 1.08
    },
    "spatial": {
