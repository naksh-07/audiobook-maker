      "ducking_db": -16.0
    }
  },
  {
    "index": 5,
    "type": "dialogue",
    "speaker": "Nenneke",
    "text": "ये ऊँचे खानदान के सज्जन, ड्यूक हियरवर्ड की सेवा में हैं, जो इन ज़मीनों पर बड़ी दयालुता से राज करते हैं।",
    "emotion": "sarcastic_mocking",
