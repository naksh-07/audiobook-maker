      "ducking_db": -16.0
    }
  },
  {
    "index": 10,
    "type": "dialogue",
    "speaker": "Nenneke",
    "text": "आओ असल बात पर आते हैं कि 'सफेद गुलाब' के ये शूरवीर मेरे इस मामूली मंदिर में क्यों आए हैं। गेराल्ट, तुम तो जानते ही हो कि ये पंथ हियरवर्ड से संरक्षण माँग रहा है, इसीलिए गुलाब के इतने सारे शूरवीर उसकी सेवा में आ गए हैं। और यहाँ के कुछ स्थानीय लोग, जैसे कि ये टेल्स, इन्होंने भी शपथ लेकर ये लाल लबादा ओढ़ लिया है, जो इन पर खूब फबता है।",
    "emotion": "sharp_witty",
    "pause_after_ms": 450,
    "acting": {
      "delivery_style": "informative_mocking",
      "pacing": 0.98
    },
    "spatial": {
