# Kokoro TTS Remote Server Configuration (PC / Laptop Workstation)
# Set your laptop's IP and port once Kokoro is running there
KOKORO_API_URL=http://127.0.0.1:8880

# Default Voice: af_heart, af_bella, af_nicole, af_sky, am_adam, am_michael, bf_emma, bf_isabella, bm_george, bm_lewis
KOKORO_DEFAULT_VOICE=af_heart
KOKORO_DEFAULT_SPEED=1.0

# Mobile Output & Integration
AUDIO_OUTPUT_DIR=/storage/emulated/0/Documents/Termux/Audio
AUTO_PLAY=false
AUTO_MASTER=false
