# ==============================================================================
# Audiobook Factory & Audio Testing Environment Configuration
# Mode: Gemini 3.1 Flash Cloud Primary | High-Performance PC Workstation
# ==============================================================================

# Primary Google AI Studio API Key
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Primary TTS Engine: Google Gemini Flash TTS API
TTS_PRIMARY_BACKEND=gemini_tts
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_DEFAULT_VOICE=Aoede

# Emergency Fallback TTS Engine (Disabled: Kokoro not used)
ENABLE_EMERGENCY_FALLBACK=false

# Translation & LLM Engine
GEMINI_TEXT_MODEL=gemini-flash-latest
GEMINI_PRO_MODEL=gemini-3.1-pro-preview

# Background Score, Ambience & Music Engine
BGM_ENABLED=true
BGM_ENGINE=ambient_bed  # Options: ambient_bed, none
ENABLE_LOCAL_MUSICGEN=false  # Set to true only if local RTX GPU inference is needed
BGM_DUCKING_ATTENUATION_DB=-16
BGM_FADE_SECONDS=2.5

# Workstation Output & Integration
AUDIO_OUTPUT_DIR=audiobooks/output
AUTO_PLAY=false
AUTO_MASTER=true
