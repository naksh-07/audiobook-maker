# ==============================================================================
# Audiobook Factory & Audio Testing Environment Configuration
# Mode: Gemini API Primary | Kokoro Emergency Fallback | Antigravity Copilot
# ==============================================================================

# Primary TTS Engine: Google Gemini Cloud API
# GEMINI_API_KEY=your_gemini_api_key_here
TTS_PRIMARY_BACKEND=gemini_tts
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_DEFAULT_VOICE=Aoede

# Emergency Fallback TTS Engine: Kokoro & Goonj-1-82M (PC / Laptop RTX 4050 Workstation)
# Only activated if Gemini API returns 429 / 5xx or explicitly requested
KOKORO_API_URL=http://10.236.21.128:8880
KOKORO_DEFAULT_VOICE=hi_meera
KOKORO_DEFAULT_SPEED=1.0
ENABLE_EMERGENCY_FALLBACK=true

# Background Score, Ambience & Music Engine
BGM_ENABLED=true
BGM_ENGINE=ambient_bed  # Options: musicgen, elevenlabs, ambient_bed, none
BGM_MUSICGEN_URL=http://10.236.21.128:8881/v1/audio/music
BGM_DUCKING_ATTENUATION_DB=-16
BGM_FADE_SECONDS=2.5

# Mobile Output & Integration
AUDIO_OUTPUT_DIR=/storage/emulated/0/Documents/Termux/Audio
AUTO_PLAY=false
AUTO_MASTER=true
